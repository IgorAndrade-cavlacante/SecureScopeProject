# Copie este arquivo para ".env" (ou configure essas variáveis direto no
# provedor de deploy) e preencha com os valores reais. Nunca commite o
# arquivo ".env" de verdade — só este exemplo.

# Connection string do Postgres do Supabase.
# Onde pegar: painel do Supabase > Project Settings > Database >
# Connection string > URI (modo "Session pooler" funciona bem para o Flask).
DATABASE_URL=postgresql://postgres:SENHA_AQUI@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# Chave usada para assinar os tokens JWT. Gere um valor aleatório forte,
# por exemplo com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=troque-por-um-valor-aleatorio-forte

# Domínio(s) do frontend em produção, separados por vírgula (sem barra no
# final). Em desenvolvimento local pode deixar essa linha comentada/ausente
# que o app libera qualquer origem ("*").
# ALLOWED_ORIGINS=https://securescope.vercel.app

# Pool de conexões — mínimo e máximo de conexões mantidas abertas com o
# Postgres. O plano free do Supabase suporta até ~15 conexões simultâneas.
# Em desenvolvimento local, os defaults (1 / 10) funcionam bem.
# DB_POOL_MIN=1
# DB_POOL_MAX=10
