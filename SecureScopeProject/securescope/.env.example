# Copie este arquivo para ".env" (ou configure essas variáveis direto no
# provedor de deploy) e preencha com os valores reais. Nunca commite o
# arquivo ".env" de verdade — só este exemplo.

# Ambiente. Em producao, ativa validacoes obrigatorias e falha de forma
# segura quando um segredo ou servico essencial estiver ausente.
APP_ENV=development

# O cadastro publico fica desabilitado por padrao em producao. Ative apenas
# durante uma janela controlada de onboarding.
# ALLOW_PUBLIC_REGISTRATION=false

# Connection string do Postgres do Supabase.
# Onde pegar: painel do Supabase > Project Settings > Database >
# Connection string > URI (modo "Session pooler" funciona bem para o Flask).
DATABASE_URL=postgresql://postgres:SENHA_AQUI@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# Chave usada para assinar os tokens JWT. Gere um valor aleatório forte,
# por exemplo com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=troque-por-um-valor-aleatorio-forte

# Duracao da sessao de acesso em minutos.
JWT_ACCESS_TOKEN_MINUTES=60

# Domínio(s) do frontend em produção, separados por vírgula (sem barra no
# final). O valor e obrigatorio quando APP_ENV=production.
# ALLOWED_ORIGINS=https://securescope.vercel.app

# Quantidade de proxies reversos confiaveis na frente do Flask. Deixe zero
# quando executar diretamente; configure conforme a plataforma de deploy.
# TRUST_PROXY_COUNT=1

# Pool de conexões — mínimo e máximo de conexões mantidas abertas com o
# Postgres. O plano free do Supabase suporta até ~15 conexões simultâneas.
# Em desenvolvimento local, os defaults (1 / 10) funcionam bem.
# DB_POOL_MIN=1
# DB_POOL_MAX=10

# Storage compartilhado para rate limiting. Em producao, use Redis para que
# todas as instancias compartilhem os mesmos contadores.
# RATELIMIT_STORAGE_URI=redis://usuario:senha@host:6379/0
# RATELIMIT_LOGIN=5 per minute;20 per hour
# RATELIMIT_LOGIN_ACCOUNT=10 per hour
# RATELIMIT_REGISTER=5 per hour
# RATELIMIT_IA=30 per hour
# RATELIMIT_SCANNER=10 per hour
# RATELIMIT_DAST=3 per hour

# Provedores de IA. Nunca use valores reais neste arquivo de exemplo.
GEMINI_API_KEY=preencha-no-ambiente-seguro-do-deploy
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=preencha-no-ambiente-seguro-do-deploy

# Integracao opcional com OWASP ZAP.
# ZAP_API_URL=http://127.0.0.1:8080
# ZAP_API_KEY=preencha-no-ambiente-seguro-do-deploy

# Servidor de desenvolvimento local. Em producao, use um servidor WSGI.
# FLASK_HOST=127.0.0.1
# PORT=5000
